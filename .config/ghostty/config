# Generated by Spectre - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config
# Theme: Solarized Osaka Night

# Keybinds
keybind = global:alt+t=toggle_quick_terminal

# Quick-terminal
quick-terminal-position = center
quick-terminal-screen = mouse
quick-terminal-size = 75%,60%

# Window
window-padding-x = 10
window-padding-y = 10
unfocused-split-opacity = 0.5
# Liquid Glass (macOS 26+, Ghostty 1.4): clear glass needs opacity
# below 1; the tab bar takes the same glass in the titlebar.
background-opacity = 0.6
background-blur = macos-glass-clear
macos-titlebar-style = tabs

# Colors
theme = "Solarized Osaka Night"
# The sketchybar theme picker writes this file (background, cursor,
# selection) on every colour change; loaded last, so it wins.
config-file = ?sketchybar-colors

# Mouse
mouse-hide-while-typing = true

# Advanced
adjust-cursor-thickness = 2

# Application
initial-window = false
