# Keybinds
keybind = global:alt+t=toggle_quick_terminal

# Quick-terminal
quick-terminal-position = center
quick-terminal-screen = mouse
quick-terminal-size = 75%,60%

# Window
window-padding-x = 10
window-padding-y = 10
unfocused-split-opacity = 0.5
# Liquid Glass: clear glass shows only below full opacity.
background-opacity = 0.7
background-blur = macos-glass-clear
macos-titlebar-style = tabs

# Colors
theme = "Solarized Osaka Night"
# Written by the sketchybar theme picker; loaded last, so it wins.
config-file = ?sketchybar-colors

# Mouse
mouse-hide-while-typing = true

# Advanced
adjust-cursor-thickness = 2

# Application
initial-window = false
