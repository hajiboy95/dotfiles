#!/usr/bin/env -S PATH=/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin /opt/homebrew/opt/lua@5.5/bin/lua

-- The shebang sets PATH: as a brew service, sketchybar runs with
-- launchd's minimal PATH, which lacks Homebrew, so `tailscale`,
-- `kiwidesk`, `ifstat` and `sketchybar` itself were not found from
-- the bar's commands.

-- Rebuilds the SbarLua module if the sketchybar binary is newer than
-- the compiled .so (or the .so is missing).
--
-- Temporarily pinned to our fork branch `fix/reentrant-transactions`
-- instead of upstream's old `437bd20`: that pin predates SbarLua's move
-- to Lua 5.5, so an auto-rebuild would install a module incompatible
-- with this config's lua@5.5 interpreter (empty bar), and it lacks our
-- command-stream fixes (FelixKratz/SbarLua#62).
--
-- TODO: once PR #62 is merged, revert this to upstream — replace the
-- clone+checkout below with the stock line (upstream now vendors 5.5):
--   git clone https://github.com/FelixKratz/SbarLua.git /tmp/SbarLua
--   && cd /tmp/SbarLua/ && make install
-- i.e. swap the hajiboy95 URL back to FelixKratz and drop the
-- `git checkout fix/reentrant-transactions`.
os.execute("[ ! -f $HOME/.local/share/sketchybar_lua/sketchybar.so ] || [ $(command -v sketchybar) -nt $HOME/.local/share/sketchybar_lua/sketchybar.so ] && (rm -rf /tmp/SbarLua && git clone https://github.com/hajiboy95/SbarLua.git /tmp/SbarLua && cd /tmp/SbarLua/ && git checkout fix/reentrant-transactions && make install && rm -rf /tmp/SbarLua/)")

-- Cap the Homebrew service logs on each (re)load so a command-stream
-- storm can never balloon them (KiwiDesk issue #24 once hit 1.7 GB).
-- Truncating in place preserves the daemon's append fd. Portable:
-- resolves the Homebrew prefix at runtime, no hard-coded user paths.
os.execute([[
  prefix="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
  logdir="$prefix/var/log/sketchybar"
  for f in "$logdir/sketchybar.out.log" "$logdir/sketchybar.err.log"; do
    [ -f "$f" ] || continue
    if [ "$(stat -f%z "$f" 2>/dev/null || echo 0)" -gt $((25*1024*1024)) ]; then
      : > "$f"
    fi
  done
]])

-- Add the sketchybar module to the package cpath (the module could be
-- installed into the default search path then this would not be needed)
package.cpath = package.cpath .. ";/Users/" .. os.getenv("USER") .. "/.local/share/sketchybar_lua/?.so"

-- Require the sketchybar module
sbar = require("sketchybar")

-- Bundle the entire initial configuration into a single message to sketchybar
-- This improves startup times drastically, try removing both the begin and end
-- config calls to see the difference -- yeah..
sbar.begin_config()
require("init")
sbar.hotload(true)
sbar.end_config()

-- Run the event loop of the sketchybar module (without this there will be no
-- callback functions executed in the lua module)
sbar.event_loop()
