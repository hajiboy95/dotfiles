# macOS system files
.DS_Store

# Ignore everything in .config
.config/*
.venv/
**/bin/

# Exceptions
!.config/sketchybar/
!.config/sketchybar_bash/
!.config/raycast_scripts/
!.config/ghostty
!.config/aerospace_scripts/
!.config/starship.toml
!.config/direnv/
!.config/karabiner/
!.config/KiwiDesk/
.config/KiwiDesk/*
# Only the event hooks are tracked. gui.json and profiles/ are GUI-managed and
# still in flux, so they stay local.
!.config/KiwiDesk/init.lua

# Picked theme state (sketchybar theme picker): per machine
.config/sketchybar/helpers/active_theme.txt
.config/sketchybar/helpers/active_look.txt
