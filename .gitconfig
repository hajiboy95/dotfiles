[core]
	attributesfile = ~/.gitattributes
[pull]
	rebase = false
[filter "strip-notebook-output"]
	clean = ~/dotfiles/notebook_cleaning/.venv/bin/jupyter-nbconvert --ClearOutputPreprocessor.enabled=True --ClearMetadataPreprocessor.enabled=True --to=notebook --stdin --stdout --log-level=ERROR
[safe]
	directory = /opt/homebrew
[user]
	email = 89179997+hajiboy95@users.noreply.github.com
	name = hajiboy95
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
